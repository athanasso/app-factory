# Google Gemini Pro & Flash API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Backend API Express Server Port
PORT=3001

# WebSocket Server Port for real-time progress streaming
WS_PORT=3002

# Absolute filesystem root directory where your published React Native / Expo projects are located
PROJECTS_ROOT=D:/Projects/RN/published

# Absolute file path to your Google Cloud OAuth 2.0 / Play Store Developer Service Account credentials JSON
PLAY_CONSOLE_KEY_PATH=D:/Projects/app-factory/service-account.json
